# Configuración pública de Supabase para compilar la aplicación estática.
# La publishable key puede estar en el frontend y siempre debe usarse con RLS.
# Nunca incluyas aquí service_role, secret keys, tokens ni contraseñas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Se define automáticamente con la ruta base de GitHub Pages en el workflow.
NEXT_PUBLIC_BASE_PATH=
