# Caddy sirve el export estático. Variables de entorno:
#   SITE_ADDRESS  dirección del sitio (dev: localhost; producción: el dominio real)
#   HTTP_PORT / HTTPS_PORT  puertos internos (los publica docker-compose)
{
	# HTTP/2 y HTTP/3 (QUIC) vienen activados por defecto con TLS.
	servers {
		protocols h1 h2 h3
	}
	# En dev no se usa el Caddy ACME público: certificado interno.
	{$CADDY_GLOBAL_OPTIONS}
}

{$SITE_ADDRESS:localhost} {
	{$CADDY_TLS:tls internal}
	root * /srv

	# Prioridad br > zstd > gzip desde los archivos precomprimidos en build.
	# La compresión dinámica solo cubre lo que no se precomprimió.
	encode zstd gzip
	file_server {
		precompressed br zstd gzip
	}

	# Export con trailingSlash: /ruta/ -> /ruta/index.html; rutas desconocidas -> 404.html.
	handle_errors {
		rewrite * /404.html
		encode zstd gzip
		file_server
	}

	@immutable path /_next/static/* /optimized/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path / /*/ *.html
	header @html Cache-Control "no-cache"

	@media path *.mp4 *.webm *.webp *.avif *.png *.jpg *.jpeg *.svg *.woff2 *.ico
	header @media Cache-Control "public, max-age=2592000"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Next export inyecta scripts inline: se permite 'unsafe-inline' en script-src;
		# connect-src permite Supabase (URL pública en el build) y su Realtime (wss).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self'; connect-src 'self' {$CSP_CONNECT:https: wss:}; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		defer
	}
}
