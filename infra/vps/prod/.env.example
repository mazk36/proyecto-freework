# Variables de la pila de producción (Supabase autoalojado + web + Caddy).
# scripts/generate-secrets.sh copia este archivo a .env y RELLENA las claves con valores nuevos.
# El .env real nunca se sube a git (está en .gitignore); este ejemplo solo lleva valores no sensibles.

# ---------- Nombres y puertos ----------
# En local se prueba con *.localhost (el navegador los resuelve a tu propio equipo) y el certificado interno de Caddy.
# En el VPS: dominios reales, puertos 80/443 y CADDY_TLS vacío (certificados automáticos de Let's Encrypt).
WEB_HOST=web.matchwork.localhost
API_HOST=api.matchwork.localhost
HTTP_PORT=9080
HTTPS_PORT=9443
# Dirección del equipo en la que escuchan los puertos (127.0.0.1 = solo este equipo; en el VPS 0.0.0.0).
BIND_ADDRESS=127.0.0.1
# URLs públicas (con el puerto si no es el 443).
SITE_URL=https://web.matchwork.localhost:9443
API_URL=https://api.matchwork.localhost:9443
# Local: "tls internal" y sin redirección 80->443. VPS: dejar ambas vacías.
CADDY_TLS="tls internal"
CADDY_GLOBAL_OPTIONS="auto_https disable_redirects"

# ---------- Claves (las genera scripts/generate-secrets.sh; no las escribas a mano) ----------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=

# ---------- Autenticación ----------
JWT_EXPIRY=3600
# Redirecciones permitidas tras confirmar el correo (comodín al final).
URI_ALLOW_LIST=https://web.matchwork.localhost:9443/auth/callback/**
# Correos por hora (GOTRUE_RATE_LIMIT_EMAIL_SENT) y espera mínima entre envíos al mismo usuario.
RATE_LIMIT_EMAIL_SENT=60
SMTP_MAX_FREQUENCY=1m0s
# Captcha Cloudflare Turnstile (vacío = apagado). La clave pública va en la web (build), la privada aquí.
CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Google (vacío = apagado). Ver docs/security/auth-produccion.md.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ---------- Correo ----------
# Local: Mailpit (perfil "mailpit"). VPS: el SMTP del proveedor (Resend, Postmark, SES...).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-responder@matchwork.localhost
SMTP_SENDER_NAME=MatchWork
MAILPIT_UI_PORT=9425

# ---------- Copias de seguridad ----------
BACKUP_DIR=./backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Destino S3-compatible opcional (necesita la CLI de AWS en el equipo que ejecuta backup.sh).
# Las credenciales van en AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY del entorno, nunca en este archivo.
BACKUP_S3_URL=
BACKUP_S3_ENDPOINT=

# ---------- Límites de memoria ----------
MEM_DB=1g
MEM_AUTH=256m
MEM_REST=256m
MEM_REALTIME=512m
MEM_STORAGE=256m
MEM_KONG=512m
MEM_CADDY=256m
