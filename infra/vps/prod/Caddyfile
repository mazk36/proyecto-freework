# Caddy delante de todo: la web estática (compresión y caché) y la API de Supabase (Kong).
# Variables: WEB_HOST, API_HOST, CADDY_TLS, CADDY_GLOBAL_OPTIONS (ver .env.example).
{
	servers {
		protocols h1 h2 h3
	}
	{$CADDY_GLOBAL_OPTIONS}
}

{$WEB_HOST} {
	{$CADDY_TLS}
	root * /srv

	encode zstd gzip
	file_server {
		precompressed br zstd gzip
	}

	handle_errors {
		rewrite * /404.html
		encode zstd gzip
		file_server
	}

	@immutable path /_next/static/* /optimized/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html path / /*/ *.html
	header @html Cache-Control "no-cache"
	@media path *.mp4 *.webm *.webp *.avif *.png *.jpg *.jpeg *.svg *.woff2 *.ico
	header @media Cache-Control "public, max-age=2592000"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self'; connect-src 'self' https://{$API_HOST}:* wss://{$API_HOST}:*; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
		defer
	}
}

{$API_HOST} {
	{$CADDY_TLS}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
		defer
	}
	# Kong reenvía a Auth, REST, Realtime (WebSocket) y Storage.
	reverse_proxy kong:8000 {
		flush_interval -1
	}
}
